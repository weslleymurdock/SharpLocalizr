{
  "platformOptions": {
    "Coverlet": {
      "include": "[Localizr.Application]*,[Localizr.Domain]*,[Localizr.Infrastructure]*,[Localizr]*",
      "exclude": "[Localizr.UnitTests]*,[FluentValidation*]*,[Mediator*]*,[Microsoft.*]*,[System.*]*,[NSubstitute*]*,[Castle.*]*,[xunit.*]*,[coverlet.*]*,[testhost*]*,[Microsoft.Testing.*]*",
      "excludeByAttribute": "GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute,CompilerGeneratedAttribute",
      "excludeByFile": "**/*.g.cs,**/*.g.i.cs,**/obj/**/*.cs,**/Migrations/*.cs",
      "format": "cobertura",
      "includeTestAssembly": false,
      "skipAutoProps": false,
      "deterministicReport": false,
      "excludeAssembliesWithoutSources": "MissingAll"
    }
  }
}
